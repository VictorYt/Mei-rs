##fileformat=VCFv4.2
##source=mei-rs {version}
##mei-rsCommand={command}
##contig=<ID=chr1,length=20000>
##contig=<ID=chr2,length=10000>
##ALT=<ID=INS:ME:ALU,Description="Insertion of an Alu element">
##ALT=<ID=INS:ME:LINE1,Description="Insertion of a LINE-1 element">
##ALT=<ID=INS:ME:SVA,Description="Insertion of an SVA element">
##ALT=<ID=INS:ME,Description="Insertion of a mobile element of unknown family">
##FILTER=<ID=PASS,Description="All filters passed">
##FILTER=<ID=no_junction,Description="Fewer soft-clips at the junctions than --min-clips (short ones count only with an MEI mate)">
##FILTER=<ID=no_tail,Description="No soft-clip with a poly(A/T) tail (with --require-tail)">
##FILTER=<ID=untyped,Description="Fewer junction soft-clips typed to an MEI consensus than --min-typed-clips">
##FILTER=<ID=non_mei_mates,Description="Fewer MEI mates than --min-mei-mate-fraction of the checked mates">
##FILTER=<ID=tandem_repeat,Description="Soft-clips explained by a longer reference homopolymer or tandem repeat">
##FILTER=<ID=probe_edge,Description="Soft-clips at a probe edge without a tail, typed clip or TSD (capture artefact)">
##FILTER=<ID=low_ratio,Description="Supporting reads per read of local depth below --min-signal-ratio">
##FILTER=<ID=low_qual,Description="Quality score below --min-qual">
##INFO=<ID=SVTYPE,Number=1,Type=String,Description="Type of structural variant">
##INFO=<ID=SVLEN,Number=1,Type=Integer,Description="Length of the element consensus covered by the reads (MEINFO end - start + 1): a lower bound of the inserted length">
##INFO=<ID=MEINFO,Number=4,Type=String,Description="Mobile element info of the form NAME,START,END,POLARITY: subfamily, part of its consensus covered by the reads (1-based), strand">
##INFO=<ID=IMPRECISE,Number=0,Type=Flag,Description="No junction assembled: junctions estimated from the soft-clips">
##INFO=<ID=CIPOS,Number=2,Type=Integer,Description="Confidence interval around POS for an insertion placed by its mate signals only">
##INFO=<ID=BREAKPOINT_CLIPS,Number=1,Type=Integer,Description="Reads soft-clipped by 3 bases or more at POS, for an insertion without junction soft-clips placed among them">
##INFO=<ID=LEFT_JUNCTION,Number=1,Type=Integer,Description="End of the upstream flank (1-based: the insertion is right after this base)">
##INFO=<ID=RIGHT_JUNCTION,Number=1,Type=Integer,Description="Start of the downstream flank, minus one (1-based: the downstream flank starts after this base)">
##INFO=<ID=TSD,Number=1,Type=String,Description="Target site duplication, from the assembled junctions">
##INFO=<ID=TSD_LEN,Number=1,Type=Integer,Description="Length of the target site duplication (assembled, or estimated from the soft-clips)">
##INFO=<ID=POLYA_LEN,Number=1,Type=Integer,Description="Length of the poly(A) (or poly(T)) tail, from an assembled junction">
##INFO=<ID=ASSEMBLED,Number=1,Type=String,Description="Junctions assembled: both, left, right or none">
##INFO=<ID=CONFIDENCE,Number=1,Type=String,Description="Confidence of a PASS candidate: high (tail and TSD), medium (tail), low (no tail)">
##INFO=<ID=SUPPORT,Number=1,Type=Integer,Description="Distinct supporting reads">
##INFO=<ID=JUNCTION_CLIPS,Number=2,Type=Integer,Description="Soft-clips at the left and right junctions">
##INFO=<ID=TAIL_CLIPS,Number=2,Type=Integer,Description="Soft-clips with a poly(A) and with a poly(T) tail">
##INFO=<ID=TYPED_CLIPS,Number=1,Type=Integer,Description="Junction soft-clips typed to the element family">
##INFO=<ID=TYPED_BY,Number=1,Type=String,Description="What typed the element: clips (junction soft-clips) or mates (no clip typed)">
##INFO=<ID=MATES,Number=2,Type=Integer,Description="Reads with an unmapped mate, and with a discordant mate (low MAPQ, another contig, large insert)">
##INFO=<ID=MEI_MATES,Number=2,Type=Integer,Description="Mates checked against the consensus sequences, and of these mates of the element family">
##INFO=<ID=DISTINCT_STARTS,Number=1,Type=Integer,Description="Distinct fragment start positions of the supporting reads">
##INFO=<ID=SIGNAL_RATIO,Number=1,Type=Float,Description="Supporting reads per read of local depth">
##FORMAT=<ID=GT,Number=1,Type=String,Description="Genotype">
##FORMAT=<ID=GQ,Number=1,Type=Integer,Description="Genotype quality: phred-scaled probability that the genotype is wrong">
##FORMAT=<ID=AD,Number=R,Type=Integer,Description="Reads of the reference allele (aligned over the whole site) and of the insertion (clipped at a junction)">
##FORMAT=<ID=DP,Number=1,Type=Integer,Description="Reads counted for the genotype">
#CHROM	POS	ID	REF	ALT	QUAL	FILTER	INFO	FORMAT	positive
